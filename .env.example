# ═══════════════════════════════════════════════════════════════════════
# PIEDIABETICO.LAT — TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# Copiar este archivo a .env y completar los valores secretos en el VPS
# NUNCA commitear el archivo .env real al repositorio
# ═══════════════════════════════════════════════════════════════════════

# ── 1. AMBIENTE & SEGURIDAD GENERAL ──────────────────────────────────
ENVIRONMENT=production # 'development' | 'staging' | 'production'
SECRET_KEY=CAMBIAR_POR_SECRET_KEY_ALEATORIA_DE_64_CARACTERES
ADMIN_API_KEY=CAMBIAR_POR_ADMIN_API_KEY_SUPER_SECRETA_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 horas

# ── 2. CORS ALLOWLIST (Dominios Autorizados) ─────────────────────────
ALLOWED_ORIGINS=https://piediabetico.lat,https://app.piediabetico.lat,https://piediabetico.online,http://localhost:3000,http://localhost:8000

# ── 3. BASE DE DATOS POSTGRESQL ──────────────────────────────────────
POSTGRES_DB=piediadbetico
POSTGRES_USER=adminpd
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SUPER_SEGURA
DATABASE_URL=postgresql://adminpd:CAMBIAR_PASSWORD_POSTGRES_SUPER_SEGURA@postgres:5432/piediadbetico

# ── 4. REDIS (Broker Celery & Caché) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 5. MINIO (Object Storage S3) ─────────────────────────────────────
MINIO_ROOT_USER=adminminio
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD_MINIO_SUPER_SEGURA
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ── 6. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (SERVER-SIDE) ──────────
# Estas claves residen EXCLUSIVAMENTE en el servidor backend
NVIDIA_NIM_API_KEY=nvapi-TU_CLAVE_NVIDIA_AQUI
DASHSCOPE_API_KEY=sk-TU_CLAVE_ALIBABA_AQUI
GEMINI_API_KEY=AIzaSy_TU_CLAVE_GOOGLE_AQUI
GROQ_API_KEY=gsk_TU_CLAVE_GROQ_AQUI
ANTHROPIC_API_KEY=sk-ant-TU_CLAVE_CLAUDE_AQUI

# ── 7. RUTAS DE MODELOS LOCALES ONNX ─────────────────────────────────
CLASIFICADOR_ONNX_PATH=/app/modelos/dfu_efficientnet_b0.onnx
SEGMENTADOR_ONNX_PATH=/app/modelos/hardnet_dfus.onnx
